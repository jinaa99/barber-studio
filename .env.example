# Copy to .env.local (read by Next.js, Prisma and the npm scripts). Placeholders only:
# never commit real values.

# Public origin used for canonical, hreflang and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL 14+ with the btree_gist extension available (standard on managed Postgres).
# `npm run db:local` starts a local server and prints matching URLs.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/studio08
# Separate database for `npm run test:integration`. Its name must contain "test":
# the tests empty every table in it.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/studio08_test

# Confirmation emails (optional). Leave unset and bookings still work; each
# notification is then recorded as SKIPPED and the customer is told no email was sent.
EMAIL_PROVIDER=
RESEND_API_KEY=
# A sender on a domain verified with the provider, e.g. "STUDIO / 08 <bookings@your-domain.mn>".
EMAIL_FROM=

# First staff account, for `npm run admin:create` only (it prompts for anything left unset).
# Prefer passing these inline for the one command rather than storing them here.
ADMIN_EMAIL=hbatsaihan110@gmail.com
ADMIN_NAME=haru
ADMIN_PASSWORD=haru
# ADMIN or STAFF
ADMIN_ROLE=ADMIN
