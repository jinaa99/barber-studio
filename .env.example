# Copy to .env.local (read by Next.js, Prisma and the npm scripts). Placeholders only:
# never commit real values.

# Public origin used for canonical, hreflang and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL 14+ with the btree_gist extension available (standard on managed Postgres).
# `npm run db:local` starts a local server and prints matching URLs.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/studio08
# Separate database for `npm run test:integration`. Its name must contain "test":
# the tests empty every table in it.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/studio08_test

# Confirmation emails (optional). Leave unset and bookings still work; each
# notification is then recorded as SKIPPED and the customer is told no email was sent.
# The only supported provider is "resend" (needs all three values below).
EMAIL_PROVIDER=
RESEND_API_KEY=
# A sender on a domain verified with the provider, e.g. "STUDIO / 08 <bookings@your-domain.mn>".
EMAIL_FROM=

# Stock media search in the dashboard (optional). Server-side only: never prefix
# these with NEXT_PUBLIC_. Without them the media library still works for uploads
# and the site is unaffected; the search tab explains how to enable it.
# Free keys: https://www.pexels.com/api/ and https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Where media library files (saved stock media and uploads) are stored. Must be
# writable, persistent across deploys and shared by every server instance.
# Default: ./storage/media
MEDIA_STORAGE_DIR=

# Facebook Page and Instagram connections in the dashboard (optional). Server-side
# only: never prefix these with NEXT_PUBLIC_. Without them both connections show
# "Not set up" and the rest of the site is unaffected. Setup: docs/SOCIAL.md.
# The OAuth redirect URIs are built from NEXT_PUBLIC_SITE_URL (https in production).
# Facebook Login for Business: the Meta app's App ID and App Secret.
META_APP_ID=
META_APP_SECRET=
# Business Login for Instagram: the *Instagram* app ID and secret from
# App Dashboard → Instagram → API setup with Instagram login (not the Meta App ID).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Encrypts stored access tokens (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Changing it makes existing connections unreadable; they then ask to be reconnected.
SOCIAL_TOKEN_KEY=
# Optional: a Facebook Login for Business configuration ID ("User access token" type,
# with the permissions listed in docs/SOCIAL.md). When set it is sent instead of `scope`.
META_LOGIN_CONFIG_ID=
# Graph API version for Facebook and Instagram calls. Default: v26.0
META_GRAPH_VERSION=

# First staff account, for `npm run admin:create` only (it prompts for anything left unset).
# Prefer passing these inline for the one command rather than storing them here.
# The password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# ADMIN or STAFF
ADMIN_ROLE=ADMIN

# Optional overrides
# Port for `npm run db:local` (default 5433).
LOCAL_DB_PORT=
# `npm run db:seed` skips the sample appointments when "false".
SEED_SAMPLE_APPOINTMENTS=
# `npm run db:seed` refuses to run with NODE_ENV=production unless this is "true".
SEED_ALLOW_PRODUCTION=
